<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="CircuitAssistant.Controls.MathFormulaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="10,8">
        <Grid ColumnDefinitions="*,Auto">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <TextBlock
                    x:Name="FormulaText"
                    FontFamily="Cambria Math, Latin Modern Math, STIX Two Math, Segoe UI Variable Text, Consolas"
                    FontSize="13.5"
                    LineHeight="24"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="NoWrap" />
            </ScrollViewer>

            <Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Margin="8,0,0,0"
                Padding="6,3"
                Click="CopyLatex_Click"
                ToolTipService.ToolTip="复制原始 LaTeX 表达式"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="CopyText" Text="LaTeX" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
