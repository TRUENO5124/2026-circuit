<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="CircuitAssistant.Controls.CircuitCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
          AllowDrop="True"
          DragOver="Canvas_DragOver"
          Drop="Canvas_Drop">
        <!-- Win2D Hardware Accelerated Canvas -->
        <canvas:CanvasControl
            x:Name="Canvas"
            ClearColor="Transparent"
            CreateResources="Canvas_CreateResources"
            Draw="Canvas_Draw"
            PointerMoved="Canvas_PointerMoved"
            PointerPressed="Canvas_PointerPressed"
            PointerReleased="Canvas_PointerReleased"
            PointerWheelChanged="Canvas_PointerWheelChanged" />

        <!-- Canvas Toolbar Overlay (Top-Right) -->
        <Border
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="16"
            Padding="6"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Click="ZoomIn_Click" ToolTipService.ToolTip="放大 (滚轮向上)">
                    <FontIcon Glyph="&#xE71E;" FontSize="12" />
                </Button>
                <Button Click="ZoomOut_Click" ToolTipService.ToolTip="缩小 (滚轮向下)">
                    <FontIcon Glyph="&#xE71F;" FontSize="12" />
                </Button>
                <Button Click="ResetView_Click" ToolTipService.ToolTip="复位视图 (100%)">
                    <FontIcon Glyph="&#xE895;" FontSize="12" />
                </Button>
                <TextBlock
                    x:Name="ZoomText"
                    VerticalAlignment="Center"
                    Margin="6,0,4,0"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="100%" />
            </StackPanel>
        </Border>

        <!-- Selected Element Floating Quick Bar (Top-Left) -->
        <Border
            x:Name="SelectionActionBar"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="16"
            Padding="8,5"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE762;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="SelectionBarText" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Text="已选中元器件" />
                <Button Click="RotateSelected_Click" ToolTipService.ToolTip="顺时针旋转 90° (快捷键 R)" Style="{StaticResource SubtleButtonStyle}" Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE7AD;" FontSize="12" />
                        <TextBlock Text="旋转" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Click="DeleteSelected_Click" ToolTipService.ToolTip="删除元器件 (快捷键 Delete)" Style="{StaticResource SubtleButtonStyle}" Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="删除" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </Button>
                <Button Click="Deselect_Click" ToolTipService.ToolTip="取消选中 (快捷键 Esc)" Style="{StaticResource SubtleButtonStyle}" Padding="4">
                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Canvas Legend & Instruction Overlay (Bottom-Left) -->
        <Border
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="16"
            Padding="10,6"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE8B9;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="单击元器件即可选中并拖拽移动" />
                </StackPanel>
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="|" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE819;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="拖拽空白平移 · 滚轮缩放" />
                </StackPanel>
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="|" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="左侧库点击/拖拽添加元件" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
