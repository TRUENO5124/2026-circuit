<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CircuitAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CircuitAssistant"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="电路教学辅助系统 (Circuit Learning Assistant)"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="电路教学辅助系统 (Circuit Learning Assistant)">
            <TitleBar.LeftHeader>
                <Image
                    Width="28"
                    Height="28"
                    Margin="4,0,2,0"
                    IsHitTestVisible="False"
                    Source="Assets/Square44x44Logo.scale-200.png"
                    Stretch="Uniform"
                    UseLayoutRounding="True" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <!-- Main Full-Width Workspace Frame -->
        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Window>
