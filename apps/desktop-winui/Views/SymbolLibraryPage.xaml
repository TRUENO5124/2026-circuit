<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CircuitAssistant.Views.SymbolLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CircuitAssistant.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="高清矢量电气符号库 (Electrical Symbol Library)" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="符合 GB/T 4728 · IEC 60617 / ANSI IEEE 国际标准的工业级高清矢量符号库，支持矢量无损缩放与高精度微变模型解析"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">
                <!-- ANSI Standard Section -->
                <TextBlock Text="无源线性元件族 (Passive Component Families)" Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView SelectionMode="None">
                    <!-- Resistor ANSI -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="passive.resistor_ansi" Width="48" Height="48" />
                            <TextBlock Text="电阻器 (ANSI 美标)" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="ANSI 锯齿形经典微变符号" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Resistor IEC -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="passive.resistor" Width="48" Height="48" />
                            <TextBlock Text="电阻器 (IEC / 国标)" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="GB/T 4728 矩形框线性电阻" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Capacitor -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="passive.capacitor" Width="48" Height="48" />
                            <TextBlock Text="电容器 (Capacitor)" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="平行极板阻容耦合 / 隔直通交" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Inductor -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="passive.inductor" Width="48" Height="48" />
                            <TextBlock Text="电感器 (Inductor)" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="多匝线圈微变电感模型" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Transformer -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="passive.transformer" Width="48" Height="48" />
                            <TextBlock Text="理想变压器" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="双端口阻抗变换与同名端" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Ground -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="reference.ground" Width="48" Height="48" />
                            <TextBlock Text="参考地 (GND / 0V)" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="统一零电位基准参考节点" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </GridView>

                <!-- Semiconductor & Source Section -->
                <TextBlock Text="半导体管与激励源元件族 (Semiconductors &amp; Sources)" Style="{StaticResource SubtitleTextBlockStyle}" />
                <GridView SelectionMode="None">
                    <!-- BJT NPN -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="bjt.npn" Width="48" Height="48" />
                            <TextBlock Text="NPN 双极型晶体管" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="B-C-E 三端小信号混合π模型" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- BJT PNP -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="bjt.pnp" Width="48" Height="48" />
                            <TextBlock Text="PNP 双极型晶体管" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="双极型互补推挽管" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Diode -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="diode.standard" Width="48" Height="48" />
                            <TextBlock Text="二极管 (Diode)" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="单向导电限幅整流器件" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- MOSFET -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="fet.mosfet" Width="48" Height="48" />
                            <TextBlock Text="NMOS 增强型管" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="四端绝缘栅场效应晶体管" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- DC Voltage Source -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="source.v_dc" Width="48" Height="48" />
                            <TextBlock Text="直流独立电压源" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="VCC / 直流静态偏置电源" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- AC Source -->
                    <Border Width="190" Height="150" Padding="12" Margin="6"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:CircuitSymbolPreview SymbolId="source.v_ac_small_signal" Width="48" Height="48" />
                            <TextBlock Text="交流正弦信号源" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="小信号微变等效激励输入" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </GridView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
