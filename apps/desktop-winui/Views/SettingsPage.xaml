<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CircuitAssistant.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24,12,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="系统设置 (Settings)" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="配置 Fluent 主题外观、后台推导引擎服务与应用属性"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                <!-- Appearance Card -->
                <Border Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="外观与材质" FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid>
                            <StackPanel Spacing="2">
                                <TextBlock Text="应用主题" FontWeight="SemiBold" />
                                <TextBlock Text="选择明亮、暗黑或跟随 Windows 11 系统设置"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox HorizontalAlignment="Right" SelectedIndex="0" Width="160">
                                <ComboBoxItem Content="跟随系统 (Default)" />
                                <ComboBoxItem Content="浅色模式 (Light)" />
                                <ComboBoxItem Content="深色模式 (Dark)" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="背景材质" FontWeight="SemiBold" />
                                <TextBlock Text="已启用 Windows 11 原生 Mica (云母) 背景材质"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch HorizontalAlignment="Right" IsOn="True" IsEnabled="False" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Backend API Service Card -->
                <Border Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="推导引擎服务连接" FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="FastAPI 本地服务地址" Text="http://127.0.0.1:8000" />
                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="测试连接" />
                        </Grid>
                        <TextBlock Text="注：当本地服务未启动时，WinUI 客户端内置备用微变等效与时间常数法教学引擎，保证离线状态下同样可完成标准教学推导与展示。"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- About Card -->
                <Border Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="关于电路教学辅助系统" FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="版本: 2.0.0 (WinUI 3 原生重构版)" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="技术栈: Windows App SDK 最新版, WinUI 3, .NET 9, Microsoft Win2D, CommunityToolkit.Mvvm"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="严格遵循微软 Fluent Design System 设计规范，全链路采用标准国际数学科学计数法排版。"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
