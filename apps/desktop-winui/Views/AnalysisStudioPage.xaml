<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CircuitAssistant.Views.AnalysisStudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CircuitAssistant.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:CircuitAssistant.Models"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Top Command & Ribbon Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main 3-Column Workspace -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- Top Command Toolbar                                      -->
        <!-- ======================================================== -->
        <Border
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,8,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Project Title & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border
                        Width="36"
                        Height="36"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8EF;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                            <Border
                                Visibility="{x:Bind ViewModel.HasActiveProject, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                CornerRadius="4"
                                Padding="6,1">
                                <TextBlock Text="当前工程" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                            <Border
                                Visibility="{x:Bind ViewModel.HasActiveProject, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="4"
                                Padding="6,1">
                                <TextBlock Text="空白工作区" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Text="分压式偏置共射放大电路 · 直流工作点 Q、微变等效与频率特性教学推导"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Center Status Badge -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <InfoBadge Style="{StaticResource SuccessDotInfoBadgeStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Quick Actions Toolbar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Add / New Project DropDown -->
                    <DropDownButton Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="添加工程" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.CreateBlankProjectCommand}"
                                    Text="新建空白电路工程">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.CreateDefaultProjectCommand}"
                                    Text="分压式偏置共射放大电路 (教学推荐)">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE943;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.CreateAcCoupledProjectCommand}"
                                    Text="阻容耦合单管放大电路">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE756;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Close Active Project Button -->
                    <Button
                        Command="{x:Bind ViewModel.CloseProjectCommand}"
                        Visibility="{x:Bind ViewModel.HasActiveProject, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        Style="{StaticResource DefaultButtonStyle}"
                        ToolTipService.ToolTip="关闭当前工程并返回空白工作区">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                            <TextBlock Text="关闭工程" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <ToggleSwitch
                        Header=""
                        Visibility="{x:Bind ViewModel.HasActiveProject, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.ShowMnaLogs, Mode=TwoWay}"
                        OffContent="MNA日志: 隐藏"
                        OnContent="MNA日志: 显示"
                        FontSize="12" />

                    <Button
                        Command="{x:Bind ViewModel.ResetToDefaultsCommand}"
                        Visibility="{x:Bind ViewModel.HasActiveProject, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        Style="{StaticResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="13" />
                            <TextBlock Text="重置参数" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button
                        Command="{x:Bind ViewModel.SolveCircuitCommand}"
                        Visibility="{x:Bind ViewModel.HasActiveProject, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAnalyzing, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                IsActive="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsAnalyzing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                            <FontIcon
                                Glyph="&#xE768;"
                                FontSize="13"
                                Visibility="{x:Bind ViewModel.IsAnalyzing, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                            <TextBlock Text="求解与理论分析" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- Main 3-Column Layout: Library | Canvas | Inspector       -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Symbol & Component Library (280px) -->
                <ColumnDefinition Width="280" MinWidth="240" MaxWidth="360" />
                <!-- Center: Expansive Schematic Canvas (*) -->
                <ColumnDefinition Width="*" />
                <!-- Right: Properties Inspector & Analysis Console (420px) -->
                <ColumnDefinition Width="420" MinWidth="360" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- ==================================================== -->
            <!-- 1. LEFT PANEL: 矢量电气符号库 (Symbol Library)       -->
            <!-- ==================================================== -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid Padding="12,12,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="矢量电气符号库" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <!-- Search Box -->
                        <AutoSuggestBox
                            PlaceholderText="搜索符号或元件..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SymbolSearchQuery, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Category Selector -->
                    <ComboBox
                        Grid.Row="1"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Stretch"
                        Header="元件大类分类"
                        ItemsSource="{x:Bind ViewModel.SymbolCategories}"
                        SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />

                    <!-- Symbol Cards List -->
                    <ListView
                        x:Name="SymbolListView"
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.FilteredSymbols}"
                        SelectedItem="{x:Bind ViewModel.SelectedSymbol, Mode=TwoWay}"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="SymbolListView_ItemClick"
                        CanDragItems="True"
                        DragItemsStarting="SymbolListView_DragItemsStarting">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CircuitSymbolItem">
                                <Border
                                    Padding="8,8"
                                    Margin="0,3"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Real Vector Electrical Symbol Frame -->
                                        <Border
                                            Grid.Column="0"
                                            Width="54"
                                            Height="38"
                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <controls:CircuitSymbolPreview
                                                SymbolId="{x:Bind Id}"
                                                Width="46"
                                                Height="32"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Component Family Information -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" />
                                                <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="3" Padding="4,0">
                                                    <TextBlock Text="{x:Bind Category}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                                        </StackPanel>

                                        <!-- Quick Add Button -->
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="6,6"
                                            ToolTipService.ToolTip="放置该元器件到画布"
                                            Click="AddSymbolButton_Click"
                                            Tag="{x:Bind}">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Library Footer / Standard Note -->
                    <Border
                        Grid.Row="3"
                        Margin="0,8,0,0"
                        Padding="8,6"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <TextBlock
                            Text="符合 IEC / ANSI 国际电气符号标准 · 点击元件可快速创建/配置工程"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ==================================================== -->
            <!-- 2. CENTER PANEL: 原理图设计画布 (Schematic Canvas)  -->
            <!-- ==================================================== -->
            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}">
                <!-- ================================================ -->
                <!-- 2A. BLANK PROJECT WELCOME STATE                  -->
                <!-- ================================================ -->
                <Grid
                    Visibility="{x:Bind ViewModel.HasActiveProject, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="700"
                    Margin="24">
                    <StackPanel Spacing="24" HorizontalAlignment="Center">
                        <!-- Hero Header -->
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <Border
                                Width="64"
                                Height="64"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                CornerRadius="16"
                                HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8A5;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock
                                Text="电路教学仿真与理论分析工作室"
                                FontSize="22"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="当前处于空白工作区。请选择创建全新空白电路工程，或从经典模电实验教学工程开始演练："
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center" />
                        </StackPanel>

                        <!-- Project Template Cards -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Blank Project -->
                            <Border
                                Grid.Column="0"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Width="40"
                                        Height="40"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left">
                                        <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="新建空白工程" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="创建干净的原理图画布，自由从左侧符号库放置元件并配置自定义节点参数。"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        Grid.Row="3"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.CreateBlankProjectCommand}"
                                        Style="{StaticResource DefaultButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            <TextBlock Text="创建空白工程" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Card 2: Default Recommended Template -->
                            <Border
                                Grid.Column="1"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1.5"
                                CornerRadius="8">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Border
                                            Width="40"
                                            Height="40"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            CornerRadius="8"
                                            HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE943;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                            <TextBlock Text="教学推荐" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="分压式共射放大电路" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="《电子技术基础》经典教学标准模板，含偏置电阻网络、隔直电容、旁路电容与三极管微变模型。"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        Grid.Row="3"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.CreateDefaultProjectCommand}"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock Text="载入经典工程" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Card 3: AC Coupled Template -->
                            <Border
                                Grid.Column="2"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Width="40"
                                        Height="40"
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left">
                                        <FontIcon Glyph="&#xE756;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="阻容耦合单管放大电路" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Text="标准交流放大通路电路，便于学习观察电容隔直通交与微变等效交流通路特性。"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />

                                    <Button
                                        Grid.Row="3"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.CreateAcCoupledProjectCommand}"
                                        Style="{StaticResource DefaultButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="12" />
                                            <TextBlock Text="载入工程模板" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Tip Footer -->
                        <Border
                            Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="提示：也可在左侧「矢量电气符号库」中点击任意元件符号，系统将自动创建工程并直接定位参数设置。"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================================================ -->
                <!-- 2B. ACTIVE PROJECT CANVAS STATE                  -->
                <!-- ================================================ -->
                <Grid Visibility="{x:Bind ViewModel.HasActiveProject, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <!-- Schematic Sheet Tab Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Big Direct2D Canvas Area -->
                        <RowDefinition Height="*" />
                        <!-- Bottom Pedagogical Derivation Drawer (Collapsible) -->
                        <RowDefinition Height="Auto" />
                        <!-- Bottom Status Bar -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Schematic Sheet Tab Header -->
                    <Border
                        Grid.Row="0"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,4,12,4">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="4,4,0,0"
                                    Padding="10,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ProjectFileName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                        <Button
                                            Command="{x:Bind ViewModel.CloseProjectCommand}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="2,1"
                                            ToolTipService.ToolTip="关闭此工程">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                <Button Command="{x:Bind ViewModel.ToggleBottomDrawerCommand}" ToolTipService.ToolTip="展开/折叠模电推导详解报告">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                        <TextBlock Text="解题推导抽屉" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hardware Accelerated Schematic Canvas (Pure Canva Vector Style) -->
                    <controls:CircuitCanvas
                        x:Name="MainCircuitCanvas"
                        Grid.Row="1"
                        Elements="{x:Bind ViewModel.Elements, Mode=OneWay}"
                        SelectedElement="{x:Bind ViewModel.SelectedElement, Mode=TwoWay}"
                        ElementSelected="MainCircuitCanvas_ElementSelected"
                        ElementDroppedFromLibrary="MainCircuitCanvas_ElementDroppedFromLibrary"
                        BetaText="{x:Bind GetBetaDisplay(ViewModel.BetaNumber), Mode=OneWay}"
                        C1Text="{x:Bind GetUnitDisplay(ViewModel.C1Number, ViewModel.SelectedC1Unit), Mode=OneWay}"
                        C2Text="{x:Bind GetUnitDisplay(ViewModel.C2Number, ViewModel.SelectedC2Unit), Mode=OneWay}"
                        CeText="{x:Bind GetUnitDisplay(ViewModel.CeNumber, ViewModel.SelectedCeUnit), Mode=OneWay}"
                        Rb1Text="{x:Bind GetUnitDisplay(ViewModel.Rb1Number, ViewModel.SelectedRb1Unit), Mode=OneWay}"
                        Rb2Text="{x:Bind GetUnitDisplay(ViewModel.Rb2Number, ViewModel.SelectedRb2Unit), Mode=OneWay}"
                        RcText="{x:Bind GetUnitDisplay(ViewModel.RcNumber, ViewModel.SelectedRcUnit), Mode=OneWay}"
                        ReText="{x:Bind GetUnitDisplay(ViewModel.ReNumber, ViewModel.SelectedReUnit), Mode=OneWay}"
                        RlText="{x:Bind GetUnitDisplay(ViewModel.RlNumber, ViewModel.SelectedRlUnit), Mode=OneWay}"
                        VccText="{x:Bind GetUnitDisplay(ViewModel.VccNumber, ViewModel.SelectedVccUnit), Mode=OneWay}" />

                    <!-- Bottom Collapsible Derivations Drawer -->
                    <Border
                        Grid.Row="2"
                        MaxHeight="260"
                        Visibility="{x:Bind ViewModel.IsBottomDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid Padding="16,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE82D;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="模电规范分步解题推导速览" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Click="{x:Bind ViewModel.ToggleBottomDrawer}" Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Result.Steps, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AnalysisStep">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="12,8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3" Padding="6,1">
                                                            <TextBlock Text="{x:Bind StepNumber}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Explanation}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    <controls:MathFormulaView Formula="{x:Bind LatexFormula}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Bottom Status Bar -->
                    <Border
                        Grid.Row="3"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,5">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <!-- Cursor Coordinates -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE819;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CursorCoordinateText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <!-- Grid Pitch -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE81E;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="栅格: 0.1 inch (40 px)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <!-- Direct2D Engine -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Direct2D 硬件加速 (Win2D)" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Right Status -->
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="原生矢量画布渲染模式" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="3" Padding="6,1">
                                    <TextBlock Text="求解引擎就绪" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================================================== -->
            <!-- 3. RIGHT PANEL: 参数设置与分析操控面板 (Inspector)   -->
            <!-- ==================================================== -->
            <Border
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid Padding="14,10,14,12">
                    <!-- ================================================ -->
                    <!-- 3A. EMPTY INSPECTOR PLACEHOLDER                  -->
                    <!-- ================================================ -->
                    <Grid
                        Visibility="{x:Bind ViewModel.HasActiveProject, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="320">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <Border
                                Width="54"
                                Height="54"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                CornerRadius="12"
                                HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE713;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Spacing="6">
                                <TextBlock
                                    Text="未激活电路工程"
                                    FontWeight="SemiBold"
                                    FontSize="15"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="请先在工作区添加或载入电路工程。载入后即可在此处调节电阻、电容、晶体管β等参数，并实时获取高精度 MNA 矩阵与理论推导结果。"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.CreateDefaultProjectCommand}"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                                    <TextBlock Text="立即载入教学工程" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ================================================ -->
                    <!-- 3B. ACTIVE INSPECTOR & CONTROLS                  -->
                    <!-- ================================================ -->
                    <Grid
                        Visibility="{x:Bind ViewModel.HasActiveProject, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <!-- Inspector Action Bar -->
                            <RowDefinition Height="Auto" />
                            <!-- Pivot Tabs: Parameters | Metrics | Derivation -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Action Card: Solve & Analysis -->
                        <Border
                            Grid.Row="0"
                            Margin="0,0,0,10"
                            Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="属性检查器与求解控制台" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                    <Button
                                        HorizontalAlignment="Right"
                                        Command="{x:Bind ViewModel.ResetToDefaultsCommand}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="重置为默认电路设计参数">
                                        <FontIcon Glyph="&#xE777;" FontSize="12" />
                                    </Button>
                                </Grid>

                                <!-- Primary Solve Button -->
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.SolveCircuitCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsAnalyzing, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <ProgressRing
                                                Width="16"
                                                Height="16"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                IsActive="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.IsAnalyzing, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                                            <FontIcon
                                                Glyph="&#xE768;"
                                                FontSize="14"
                                                Visibility="{x:Bind ViewModel.IsAnalyzing, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" />
                                            <TextBlock Text="求解与理论分析 (Ctrl+R)" FontWeight="SemiBold" FontSize="13" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Inspector Pivot: Parameters / Metrics / Derivation -->
                        <Pivot Grid.Row="1" SelectedIndex="{x:Bind ViewModel.SelectedRightTabIndex, Mode=TwoWay}">
                            <!-- ================================================ -->
                            <!-- TAB 1: 元件参数设置 (Parameters)                 -->
                            <!-- ================================================ -->
                            <PivotItem Header="⚙️ 参数设置">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                                    <StackPanel Spacing="12">
                                        <!-- Selected Component Inspector Card -->
                                        <Border
                                            Padding="14"
                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Visibility="{x:Bind ViewModel.SelectedElement, Converter={StaticResource NotNullToVisibilityConverter}, Mode=OneWay}">
                                            <StackPanel Spacing="10">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Border
                                                            Width="34"
                                                            Height="34"
                                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                            CornerRadius="6">
                                                            <controls:CircuitSymbolPreview
                                                                SymbolId="{x:Bind ViewModel.SelectedElement.DefinitionId, Mode=OneWay}"
                                                                Width="28"
                                                                Height="28"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{x:Bind ViewModel.SelectedElement.Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock Text="{x:Bind ViewModel.SelectedElement.DefinitionId, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border
                                                        HorizontalAlignment="Right"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                        <TextBlock Text="当前选中" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>

                                                <!-- Element Value Edit -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="70" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="元件数值:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.SelectedElement.DisplayNumber, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <TextBox Grid.Column="2" Text="{x:Bind ViewModel.SelectedElement.UnitSymbol, Mode=TwoWay}" PlaceholderText="单位" />
                                                </Grid>

                                                <!-- Coordinates & Rotation Display -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="位置布局:" FontSize="12" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectedElement.PositionDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectedElement.RotationDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>

                                                <!-- Action Buttons: Rotate & Delete -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        Grid.Column="0"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{x:Bind ViewModel.RotateSelectedElementCommand}"
                                                        Style="{StaticResource DefaultButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE7AD;" FontSize="12" />
                                                            <TextBlock Text="旋转 90° (R)" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{x:Bind ViewModel.DeleteSelectedElementCommand}"
                                                        Style="{StaticResource DefaultButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                            <TextBlock Text="删除元件 (Del)" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Instruction Hint Card (When Nothing Selected) -->
                                        <Border
                                            Padding="10,8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{x:Bind ViewModel.SelectedElement, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="提示：在画布中点击任意元器件即可高亮选中、拖拽调整布局位置，或修改参数" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Group 1: Power & DC Biasing -->
                                        <Border
                                            Padding="14"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE781;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="直流电源与偏置电阻网络" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>

                                                <!-- Vcc -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="电源 Vcc:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.VccNumber, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Symbol" ItemsSource="{x:Bind ViewModel.VoltageUnits}" SelectedItem="{x:Bind ViewModel.SelectedVccUnit, Mode=TwoWay}" />
                                                </Grid>

                                                <!-- Rb1 -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="基极 Rb1:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.Rb1Number, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Symbol" ItemsSource="{x:Bind ViewModel.ResistanceUnits}" SelectedItem="{x:Bind ViewModel.SelectedRb1Unit, Mode=TwoWay}" />
                                                </Grid>

                                                <!-- Rb2 -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="基极 Rb2:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.Rb2Number, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Symbol" ItemsSource="{x:Bind ViewModel.ResistanceUnits}" SelectedItem="{x:Bind ViewModel.SelectedRb2Unit, Mode=TwoWay}" />
                                                </Grid>

                                                <!-- Rc -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="集电极 Rc:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.RcNumber, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Symbol" ItemsSource="{x:Bind ViewModel.ResistanceUnits}" SelectedItem="{x:Bind ViewModel.SelectedRcUnit, Mode=TwoWay}" />
                                                </Grid>

                                                <!-- Re -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="发射极 Re:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.ReNumber, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Symbol" ItemsSource="{x:Bind ViewModel.ResistanceUnits}" SelectedItem="{x:Bind ViewModel.SelectedReUnit, Mode=TwoWay}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Group 2: AC Load & Capacitors -->
                                        <Border
                                            Padding="14"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="电容与交流负载参数" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>

                                                <!-- RL -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="负载 RL:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.RlNumber, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Symbol" ItemsSource="{x:Bind ViewModel.ResistanceUnits}" SelectedItem="{x:Bind ViewModel.SelectedRlUnit, Mode=TwoWay}" />
                                                </Grid>

                                                <!-- C1 -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="输入 C1:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.C1Number, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Symbol" ItemsSource="{x:Bind ViewModel.CapacitanceUnits}" SelectedItem="{x:Bind ViewModel.SelectedC1Unit, Mode=TwoWay}" />
                                                </Grid>

                                                <!-- C2 -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="输出 C2:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.C2Number, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Symbol" ItemsSource="{x:Bind ViewModel.CapacitanceUnits}" SelectedItem="{x:Bind ViewModel.SelectedC2Unit, Mode=TwoWay}" />
                                                </Grid>

                                                <!-- Ce -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="旁路 Ce:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.CeNumber, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Symbol" ItemsSource="{x:Bind ViewModel.CapacitanceUnits}" SelectedItem="{x:Bind ViewModel.SelectedCeUnit, Mode=TwoWay}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Group 3: BJT Transistor & Source Frequency -->
                                        <Border
                                            Padding="14"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE943;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="三极管模型与信号源特性" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>

                                                <!-- Beta -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="晶体管 β:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.BetaNumber, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="hFE (无量纲)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>

                                                <!-- Frequency -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="信号频率 f:" FontSize="12" />
                                                    <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.FreqNumber, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                                                    <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" DisplayMemberPath="Symbol" ItemsSource="{x:Bind ViewModel.FrequencyUnits}" SelectedItem="{x:Bind ViewModel.SelectedFreqUnit, Mode=TwoWay}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </PivotItem>

                            <!-- ================================================ -->
                            <!-- TAB 2: 实时分析指标 (Metrics Dashboard)          -->
                            <!-- ================================================ -->
                            <PivotItem Header="📊 实时指标">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                                    <StackPanel Spacing="12">
                                        <!-- Q-Point Card -->
                                        <Border
                                            Padding="14"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="10">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE8B9;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="直流静态工作点 (Q-Point)" FontWeight="SemiBold" FontSize="13" />
                                                    </StackPanel>
                                                    <InfoBadge HorizontalAlignment="Right" Style="{StaticResource SuccessDotInfoBadgeStyle}" />
                                                </Grid>

                                                <Grid RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="基极静态电流 IBQ:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Result.QPoint.Ibq, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="集电极电流 ICQ:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Result.QPoint.Icq, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="管压降 VCEQ:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Result.QPoint.Vceq, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                                                </Grid>

                                                <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="4" Padding="8,4">
                                                    <TextBlock Text="{x:Bind ViewModel.Result.QPoint.WorkingRegion, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- AC Parameters Card -->
                                        <Border
                                            Padding="14"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE756;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="交流小信号动态与频响指标" FontWeight="SemiBold" FontSize="13" />
                                                </StackPanel>

                                                <Grid RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="电压放大倍数 Av:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Result.AcParameters.VoltageGain, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="输入电阻 Ri:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Result.AcParameters.InputResistance, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="输出电阻 Ro:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Result.AcParameters.OutputResistance, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="下限截止频率 fL:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Result.AcParameters.LowerCutoffFreq, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />

                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="上限截止频率 fH:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.Result.AcParameters.UpperCutoffFreq, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />

                                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="通频带带宽 BW:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.Result.AcParameters.Bandwidth, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </PivotItem>

                            <!-- ================================================ -->
                            <!-- TAB 3: 模电分步解题推导 (Pedagogical Derivations) -->
                            <!-- ================================================ -->
                            <PivotItem Header="📘 解题推导">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                                    <StackPanel Spacing="12">
                                        <TextBlock
                                            Text="依据《电子技术基础（模拟部分）》国家统编规范，采用戴维南等效、微变等效与时间常数法进行解析推导："
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />

                                        <!-- Step Cards List -->
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Result.Steps, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AnalysisStep">
                                                    <Expander
                                                        Margin="0,0,0,10"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                                        <Expander.Header>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border
                                                                    Grid.Column="0"
                                                                    Margin="0,0,8,0"
                                                                    Padding="6,1"
                                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                    CornerRadius="4">
                                                                    <TextBlock
                                                                        FontSize="11"
                                                                        FontWeight="Bold"
                                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                                        Text="{x:Bind StepNumber}" />
                                                                </Border>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="12"
                                                                    Text="{x:Bind Title}" />
                                                                <Border
                                                                    Grid.Column="2"
                                                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                                                    CornerRadius="3"
                                                                    Padding="6,1">
                                                                    <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind MethodName}" />
                                                                </Border>
                                                            </Grid>
                                                        </Expander.Header>

                                                        <StackPanel Padding="4,8" Spacing="10">
                                                            <!-- Pedagogical Explanation Text (Wrapped, never overflows) -->
                                                            <TextBlock
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                LineHeight="20"
                                                                FontSize="12"
                                                                Text="{x:Bind Explanation}"
                                                                TextWrapping="Wrap" />

                                                            <!-- Native Formula Box (Cambria Math) -->
                                                            <Border
                                                                Padding="10,6"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock
                                                                        FontSize="10"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="符号推导公理 / 定理方程:" />
                                                                    <controls:MathFormulaView Formula="{x:Bind LatexFormula}" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Numerical Substitution Box -->
                                                            <Border
                                                                Padding="10,6"
                                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock
                                                                        FontSize="10"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                        Text="数值代入与规范科学计数法解算:" />
                                                                    <controls:MathFormulaView Formula="{x:Bind SubstitutionFormula}" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Result Value Highlight -->
                                                            <Border
                                                                Padding="10,6"
                                                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                                CornerRadius="6">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                    Text="{x:Bind ResultValue}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Bottom Raw MNA Log Expander -->
                                        <Expander
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            IsExpanded="False"
                                            Visibility="{x:Bind ViewModel.ShowMnaLogs, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE756;" FontSize="12" />
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="底层修改节点分析法 (MNA) 原始矩阵与伴随求解日志" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <Border
                                                Padding="10"
                                                Background="{ThemeResource LayerFillColorAltBrush}"
                                                CornerRadius="6">
                                                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                    <TextBlock
                                                        FontFamily="Consolas"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        IsTextSelectionEnabled="True"
                                                        Text="{x:Bind ViewModel.Result.RawMnaLog, Mode=OneWay}" />
                                                </ScrollViewer>
                                            </Border>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </PivotItem>
                        </Pivot>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
