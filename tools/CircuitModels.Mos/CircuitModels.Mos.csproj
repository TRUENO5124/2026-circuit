<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>MVVMTK0045</NoWarn>
    <RootNamespace>CircuitModels.Mos</RootNamespace>
    <AssemblyName>CircuitModels.Mos</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Shared declarative generator API (fixed by contract §8.2; owned by gen-core). -->
  <ItemGroup>
    <Compile Include="..\CircuitModels.Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Production models/services/engine sources linked exactly as in the other
       console harnesses (same pattern as tests/NonlinearCircuitChecks). -->
  <ItemGroup>
    <Compile Include="..\..\apps\desktop-winui\Models\CircuitElement.cs" Link="Models\CircuitElement.cs" />
    <Compile Include="..\..\apps\desktop-winui\Models\EngineeringUnit.cs" Link="Models\EngineeringUnit.cs" />
    <Compile Include="..\..\apps\desktop-winui\Models\AnalysisStep.cs" Link="Models\AnalysisStep.cs" />
    <Compile Include="..\..\apps\desktop-winui\Models\AnalysisResult.cs" Link="Models\AnalysisResult.cs" />
    <Compile Include="..\..\apps\desktop-winui\Models\LinearAnalysisModels.cs" Link="Models\LinearAnalysisModels.cs" />
    <Compile Include="..\..\apps\desktop-winui\Models\CircuitProjectData.cs" Link="Models\CircuitProjectData.cs" />
    <Compile Include="..\..\apps\desktop-winui\Models\CircuitWireSync.cs" Link="Models\CircuitWireSync.cs" />
    <Compile Include="..\..\apps\desktop-winui\Services\ScientificNotationFormatter.cs" Link="Services\ScientificNotationFormatter.cs" />
    <Compile Include="..\..\apps\desktop-winui\Services\TeachingDisplay.cs" Link="Services\TeachingDisplay.cs" />
    <Compile Include="..\..\apps\desktop-winui\Engine\**\*.cs" Link="Engine\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
