{
  "Version": "1.2.0",
  "ProjectName": "分压式偏置共射放大电路（Ce 旁路）",
  "ProjectFileName": "B07-common-emitter-bypassed.circuit",
  "Description": "共射放大电路的教学变体：输入侧加入信号源内阻 Rs（R6=50 Ω）与 47 μF 电解输入耦合电容 C3（正极接基极），用于说明源电压放大倍数 Aus=Av·Ri/(Rs+Ri) 以及源内阻对下限截止频率的影响（τ1=(Rs+Ri)C1）。分压式偏置稳定静态工作点，Ce 把 Re 交流旁路；由 Q 点求 rbe，再计算 Ri=Rb1∥Rb2∥rbe、Ro≈Rc 与频响。教材参考：童诗白《模拟电子技术基础》第 2 章（共射放大电路）。",
  "CreatedAt": "2026-10-18T13:41:13.8353046+08:00",
  "ModifiedAt": "2026-10-19T16:31:06.2261136+08:00",
  "Parameters": {
    "VCC": 12,
    "Rb1": 33,
    "Rb2": 10,
    "Rc": 1,
    "Re": 1,
    "RL": 1,
    "C1": 10,
    "C2": 10,
    "Ce": 47,
    "Beta": 50,
    "Freq": 1000
  },
  "ParameterUnits": {
    "VCC": "V",
    "Rb1": "kΩ",
    "Rb2": "kΩ",
    "Rc": "kΩ",
    "Re": "kΩ",
    "RL": "kΩ",
    "C1": "μF",
    "C2": "μF",
    "Ce": "μF",
    "Freq": "Hz"
  },
