{
  "Version": "1.2.0",
  "ProjectName": "分压式偏置共射放大电路（Re 不旁路）",
  "ProjectFileName": "B08-common-emitter-unbypassed.circuit",
  "Description": "发射极电阻 Re 不旁路时的共射放大电路：Re 引入交流电流负反馈，中频增益降为 Av≈-β(Rc∥RL)/[rbe+(1+β)Re]，输入电阻提高为 Ri=Rb1∥Rb2∥[rbe+(1+β)Re]，用于对比 B07 理解负反馈对增益与输入电阻的影响。教材参考：童诗白《模拟电子技术基础》第 2 章。",
  "CreatedAt": "2026-10-18T13:41:13.9591414+08:00",
  "ModifiedAt": "2026-10-19T16:24:04.401065+08:00",
  "Parameters": {
    "VCC": 12,
    "Rb1": 51,
    "Rb2": 15,
    "Rc": 3,
    "Re": 1,
    "RL": 10,
    "C1": 10,
    "C2": 10,
    "Ce": 47,
    "Beta": 100,
    "Freq": 1
  },
  "ParameterUnits": {
    "VCC": "V",
    "Rb1": "kΩ",
    "Rb2": "kΩ",
    "Rc": "kΩ",
    "Re": "kΩ",
    "RL": "kΩ",
    "C1": "μF",
    "C2": "μF",
