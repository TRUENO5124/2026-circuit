{
  "Version": "1.2.0",
  "ProjectName": "NMOS 共栅放大电路",
  "ProjectFileName": "M06-nmos-common-gate.circuit",
  "Description": "NMOS 共栅放大电路：输入信号经 C1 加到源极，栅极由 Rg1/Rg2 分压提供直流偏置（VG=4.5 V）并经旁路电容 Cb 对地交流短路（共栅），输出取自漏极 Rd。静态 ID=2 mA、VGS=2.5 V、VDS=7 V（饱和区）；小信号 Av=+gm·Rd=+12（同相），输入电阻低（Ri≈(1/gm)∥Rs≈200 Ω，工程近似 1/gm=250 Ω）、输出电阻高（Ro≈Rd=3 kΩ），适用于高频/阻抗变换场合。教材参考：童诗白《模拟电子技术基础》第 2 章（场效应管放大电路）。",
  "CreatedAt": "2026-10-18T13:43:00.6759705+08:00",
  "ModifiedAt": "2026-10-19T13:48:25.0530792+08:00",
  "Parameters": {
    "VCC": 12,
    "Rb1": 51,
    "Rb2": 15,
    "Rc": 3,
    "Re": 1,
    "RL": 10,
    "C1": 10,
    "C2": 10,
    "Ce": 47,
    "Beta": 100,
    "Freq": 1
  },
  "ParameterUnits": {
    "VCC": "V",
